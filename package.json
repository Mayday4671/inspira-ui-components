{
  "name": "inspira-ui-components-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.24.0",
  "description": "Inspira UI 风格的 Vue 3 组件库 monorepo（参考 Element Plus 库架构）",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter playground dev",
    "dev:dist": "pnpm --filter playground dev:dist",
    "dev:docs": "pnpm --filter docs dev",
    "test:workspace": "node scripts/verify-workspace-filters.mjs",
    "typecheck": "pnpm --filter inspira-ui-components typecheck",
    "build": "pnpm --filter inspira-ui-components build",
    "build:playground": "pnpm --filter playground build",
    "build:docs": "pnpm --filter docs build",
    "build:all": "pnpm typecheck && pnpm build && pnpm build:playground && pnpm build:docs"
  }
}
